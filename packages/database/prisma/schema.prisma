generator client {
  provider = "prisma-client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String           @id @default(uuid())
  firstName      String
  lastName       String
  email          String           @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Authentication Authentication[]
  sessions       Session[]
}

model Authentication {
  id                String    @id @default(uuid())
  userId            String
  provider          Provider?
  providerAccountId String?   @unique
  passwordHash      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id])
}

enum Provider {
  GOOGLE
  FACEBOOK
  GITHUB
  TWITTER
  LOCAL
}
